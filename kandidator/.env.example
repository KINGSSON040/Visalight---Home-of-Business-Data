# Public. Canonical origin, no trailing slash. Example: https://kandidator.se
NEXT_PUBLIC_SITE_URL=

# Public. Cloudflare Turnstile site key. The widget is not rendered when this is empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public. Plausible data-domain. The script loads only after analytics consent.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Public. Full Calendly scheduling URL. When empty, the employer page shows a text fallback and no iframe.
NEXT_PUBLIC_CALENDLY_URL=

# Server. Cloudflare Turnstile secret. siteverify fails closed when this is empty.
TURNSTILE_SECRET_KEY=

# Server. Resend API key.
RESEND_API_KEY=

# Server. Inbox for every form in v1.
CONTACT_TO_EMAIL=

# Server. Verified Resend sender.
CONTACT_FROM_EMAIL=

# Server. Private Vercel Blob token for CV files. Files are never written to public/.
BLOB_READ_WRITE_TOKEN=

# Server. local is the default. teamtailor is not connected and fails with an explicit error.
ATS_PROVIDER=
